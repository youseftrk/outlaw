{
  "name": "qalaa",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "node scripts/check-blind-boundary.mjs && eslint --max-warnings=0 && vitest run",
    "typecheck": "tsc --noEmit",
    "desktop": "concurrently -k \"next dev\" \"wait-on http-get://localhost:3000 && cross-env QALAA_URL=http://localhost:3000 electron .\"",
    "desktop:icon": "electron scripts/make-mac-icon.cjs",
    "desktop:build:mac": "next build && node scripts/prepare-standalone.mjs && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64 --x64",
    "desktop:build:win": "next build && node scripts/prepare-standalone.mjs && electron-builder --win dir"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@number-flow/react": "^0.6.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-table": "^9.2.4",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "border-beam": "^1.4.1",
    "bot-avatars": "^0.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "cobe": "^0.6.5",
    "date-fns": "^4.4.0",
    "dotted-map": "^3.1.0",
    "gsap": "^3.15.0",
    "liquid-gooey": "^0.2.2",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "motion": "^12.43.0",
    "nanoid": "^6.0.1",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.13.3",
    "react-use-measure": "^2.1.7",
    "recharts": "^3.8.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "ssh2": "^1.17.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "thinking-orbs": "^0.3.2",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "voice-glow": "^0.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.6",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "xyz.qalaa.app",
    "productName": "Qalaa",
    "files": [
      "desktop/**",
      ".next/standalone/**",
      "package.json",
      "!node_modules/**"
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "directories": {
      "output": "release",
      "buildResources": "desktop"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg",
      "icon": "desktop/icon.icns",
      "identity": null
    },
    "win": {
      "target": "dir"
    },
    "asar": false
  }
}
