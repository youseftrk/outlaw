# Outlaw environment
# Copy to .env.local. All values are optional — the app runs fully offline without them.

# Set to "1" to wipe .data/state.json and re-seed the demo world on next boot.
OUTLAW_RESET=

# Base URL the Electron shell loads. Defaults to http://localhost:3000 in dev.
OUTLAW_URL=

# LLM provider keys are NOT env vars. They are configured in-app (Settings → LLM)
# and stored server-side in .data/secrets.json. Presets: groq, gemini, mistral,
# cerebras, openrouter, huggingface, custom (any OpenAI-compatible endpoint).
